{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./scripts/oxlint-plugin.mjs"],
  "plugins": ["import", "oxc", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "ventiws/no-emoji": "error",
    "ventiws/no-enum": "error",
    "ventiws/no-oop": "error",
    "eqeqeq": ["error", "always"],
    "import/no-default-export": "error",
    "max-lines": [
      "error",
      {
        "max": 150
      }
    ],
    "no-else-return": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "scripts/**/*.d.mts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["tsdown.config.ts", "vitest.config.ts", "src/index.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["tests/declarations/consumer.ts"],
      "rules": {
        "import/default": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".agents/**",
    "src/types/ws.d.ts",
    "dist/**",
    "zig-out/**",
    "zig-pkg/**",
    ".zig-cache/**",
    "ventiws.js"
  ]
}
